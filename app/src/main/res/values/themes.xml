<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CampusHub" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_title</item>
        <item name="colorControlNormal">@color/color_text_hint</item>
        <item name="colorControlActivated">@color/color_primary</item>
        <item name="android:colorAccent">@color/color_primary</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:navigationBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_navigation_bar</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
        <item name="materialButtonStyle">@style/Widget.CampusHub.Button.Tonal</item>
        <item name="textInputStyle">@style/Widget.CampusHub.EditText</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CampusHub.Dialog</item>
        <item name="bottomNavigationStyle">@style/Widget.CampusHub.BottomNavigation</item>
        <item name="android:textColorPrimary">@color/color_text_title</item>
        <item name="android:textColorSecondary">@color/color_text_subtitle</item>
        <item name="android:textColorHint">@color/color_text_hint</item>
    </style>

    <style name="Theme.CampusHub.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CampusHub</item>
    </style>

    <style name="ThemeOverlay.CampusHub.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CampusHub.Large</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_title</item>
    </style>

    <style name="Widget.CampusHub.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusHub.Label</item>
        <item name="cornerRadius">@dimen/shape_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CampusHub.Button.Tonal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/color_primary_container</item>
        <item name="android:textColor">@color/color_on_primary_container</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusHub.Label</item>
        <item name="cornerRadius">@dimen/shape_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CampusHub.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/color_outline</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusHub.Label</item>
        <item name="cornerRadius">@dimen/shape_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CampusHub.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusHub.Label</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CampusHub.ExtendedFab" parent="Widget.MaterialComponents.ExtendedFloatingActionButton.Icon">
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="iconTint">@color/color_on_primary</item>
        <item name="cornerRadius">@dimen/shape_large</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusHub.Label</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CampusHub.EditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
        <item name="hintTextColor">@color/color_text_hint</item>
        <item name="boxCornerRadiusTopStart">@dimen/shape_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/shape_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/shape_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/shape_small</item>
    </style>
    <style name="Widget.CampusHub.SearchField" parent="Widget.CampusHub.EditText">
        <item name="boxCornerRadiusTopStart">@dimen/shape_large</item>
        <item name="boxCornerRadiusTopEnd">@dimen/shape_large</item>
        <item name="boxCornerRadiusBottomStart">@dimen/shape_large</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/shape_large</item>
    </style>

    <style name="TextAppearance.CampusHub.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CampusHub.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CampusHub.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CampusHub.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_text_body</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
    </style>
    <style name="TextAppearance.CampusHub.Label" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_title</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.CampusHub.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/color_text_subtitle</item>
        <item name="android:fontFamily">@font/campus_sans</item>
        <item name="fontFamily">@font/campus_sans</item>
    </style>

    <style name="ShapeAppearance.CampusHub.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/shape_small</item>
    </style>
    <style name="ShapeAppearance.CampusHub.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/shape_medium</item>
    </style>
    <style name="ShapeAppearance.CampusHub.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/shape_large</item>
    </style>
    <style name="ShapeAppearance.CampusHub.Full" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.CampusHub.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/shape_medium</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.CampusHub.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/campus_chip_background</item>
        <item name="chipStrokeColor">@color/color_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/shape_large</item>
        <item name="android:textColor">@color/campus_chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.CampusHub.Caption</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="Widget.CampusHub.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.CampusHub.BottomNavigation.ActiveIndicator</item>
        <item name="itemIconTint">@color/campus_navigation_tint</item>
        <item name="itemTextColor">@color/campus_navigation_tint</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.CampusHub.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_primary_container</item>
    </style>
</resources>
