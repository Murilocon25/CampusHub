<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_lock_circle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_title"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_subtitle"
            android:textSize="15sp"
            android:textColor="@color/text_subtitle"
            android:layout_marginBottom="36dp" />

        <EditText
            android:id="@+id/editEmailCadastro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/edittext_background"
            android:hint="@string/hint_email"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:inputType="textEmailAddress"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="emailAddress" />

        <EditText
            android:id="@+id/editSenhaCadastro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/edittext_background"
            android:hint="@string/hint_senha"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:inputType="textPassword"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginBottom="12dp"
            android:autofillHints="password" />

        <EditText
            android:id="@+id/editConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/edittext_background"
            android:hint="@string/hint_confirmar_senha"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:inputType="textPassword"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_login_background"
            android:text="@string/btn_cadastrar"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <ProgressBar
            android:id="@+id/progressBarCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtVoltarLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_voltar_login"
            android:textSize="14sp"
            android:textColor="@color/text_subtitle"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
