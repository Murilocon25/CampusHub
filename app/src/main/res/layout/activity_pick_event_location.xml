<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/event_location_picker_title"
        android:textAppearance="@style/TextAppearance.CampusHub.Title"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/event_location_picker_instructions"
        android:textColor="@color/color_text_body"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/event_location_map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:minHeight="240dp" />

    <TextView
        android:id="@+id/event_location_selection_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/color_text_body"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm_event_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:enabled="false"
        android:text="@string/event_location_confirm"
        android:textAllCaps="false" />
</LinearLayout>
