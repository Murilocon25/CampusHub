<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_5"
    android:paddingEnd="@dimen/space_4">

    <TextView
        android:id="@+id/user_events_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.CampusHub.Headline" />

    <TextView
        android:id="@+id/user_events_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:layout_marginBottom="@dimen/space_3"
        android:textAppearance="@style/TextAppearance.CampusHub.Caption" />

    <com.example.loginfirebase.ui.common.CampusStateView
        android:id="@+id/user_events_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

    <com.example.loginfirebase.ui.common.CampusSkeletonListView
        android:id="@+id/user_events_loading_skeleton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/user_events_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2" />
</LinearLayout>
