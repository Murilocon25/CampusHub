<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_4">

        <TextView
            android:id="@+id/event_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/event_greeting_fallback"
            android:textAppearance="@style/TextAppearance.CampusHub.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/events_title"
            android:textAppearance="@style/TextAppearance.CampusHub.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginBottom="@dimen/space_3"
            android:text="@string/events_intro"
            android:textAppearance="@style/TextAppearance.CampusHub.Caption" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.CampusHub.SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/events_search_hint"
            app:boxBackgroundMode="outline"
            app:startIconDrawable="@drawable/ic_search">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/event_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/category_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:clipToPadding="false"
            android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/status_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_2"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <com.example.loginfirebase.ui.common.CampusStateView
            android:id="@+id/event_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:importantForAccessibility="yes"
            android:visibility="gone" />

        <com.example.loginfirebase.ui.common.CampusSkeletonListView
            android:id="@+id/event_loading_skeleton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/event_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/list_fab_clearance"
            android:scrollbars="vertical" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/create_event_button"
        style="@style/Widget.CampusHub.ExtendedFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_5"
        android:contentDescription="@string/create_event_button"
        android:text="@string/create_event_button"
        app:backgroundTint="@color/color_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/color_on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
