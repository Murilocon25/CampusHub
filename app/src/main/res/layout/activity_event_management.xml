<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/event_manager_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_surface"
        android:title="@string/event_manager_title"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/color_text_title"
        app:titleTextAppearance="@style/TextAppearance.CampusHub.Title" />

    <TextView
        android:id="@+id/event_manager_event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:textAppearance="@style/TextAppearance.CampusHub.Headline" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_3"
        android:layout_marginEnd="@dimen/space_4"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="@dimen/shape_medium"
        app:strokeColor="@color/color_border"
        app:strokeWidth="@dimen/stroke_width">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_3">
            <TextView android:id="@+id/event_manager_capacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.CampusHub.Body" />
            <TextView android:id="@+id/event_manager_available" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampusHub.Body" />
            <TextView android:id="@+id/event_manager_waiting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampusHub.Body" />
            <TextView android:id="@+id/event_manager_checkins" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:textAppearance="@style/TextAppearance.CampusHub.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/event_manager_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_4">
        <com.google.android.material.button.MaterialButton android:id="@+id/event_manager_publish" style="@style/Widget.CampusHub.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/event_manager_publish" />
        <com.google.android.material.button.MaterialButton android:id="@+id/event_manager_end" style="@style/Widget.CampusHub.Button.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/event_manager_end" />
        <com.google.android.material.button.MaterialButton android:id="@+id/event_manager_scan" style="@style/Widget.CampusHub.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_1" android:text="@string/event_manager_scan" />
    </LinearLayout>

    <TextView
        android:id="@+id/event_manager_limited_features"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:text="@string/event_manager_limited_features"
        android:textAppearance="@style/TextAppearance.CampusHub.Caption"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CampusHub.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_4"
        android:hint="@string/event_manager_search_hint"
        app:boxBackgroundMode="outline"
        app:startIconDrawable="@drawable/ic_search">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/event_manager_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.example.loginfirebase.ui.common.CampusStateView
        android:id="@+id/event_manager_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/event_manager_participants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_4" />
</LinearLayout>
