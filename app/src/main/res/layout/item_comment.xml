<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.CampusHub.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/comment_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/comment_avatar_accessibility"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CampusHub.Label"
                android:textColor="@color/color_on_primary_container" />
            <TextView
                android:id="@+id/comment_author_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.CampusHub.Caption"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/comment_actions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/comment_actions_accessibility"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/color_text_subtitle" />
        </LinearLayout>
        <TextView
            android:id="@+id/comment_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.CampusHub.Body" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
